# ------------------------------------------------------------------
# C3 API environment variables
# ------------------------------------------------------------------
# Copy this file to `.env` for local development.
# On Railway, set these in the project dashboard under Variables.
# ------------------------------------------------------------------

# REQUIRED — JWT signing key. Generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
C3_SECRET_KEY=REPLACE_ME_WITH_64_HEX_CHARS

# OPTIONAL (Phase 7) — Firebase service account JSON as a single-line string.
# Leave empty for Phase 3.
FIREBASE_CREDENTIALS_JSON=

# OPTIONAL — Uvicorn port. Railway sets this automatically.
# PORT=8000
