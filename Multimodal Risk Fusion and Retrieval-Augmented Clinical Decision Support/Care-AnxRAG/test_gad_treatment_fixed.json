    {
      "chunk": {
        "chunk_id": "6b4f20f4b92a68b2e73abc8bc3a25e754ed33a9d",
        "document_id": "65971e1216855795ba5879865357c1bf8d6a57d2",
        "version_id": "02f4e1e985523ed71a2a5902ed205000997a67cc",
