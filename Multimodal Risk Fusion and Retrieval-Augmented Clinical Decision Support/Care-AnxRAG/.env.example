# Storage
CARE_HOME=./var
CARE_DATABASE_PATH=./var/care_anxrag.sqlite3
CARE_VECTOR_PATH=./var/chroma
CARE_SOURCE_REGISTRY=./config/sources.yaml

# Production retrieval stack
CARE_VECTOR_BACKEND=chroma
CARE_EMBEDDING_PROVIDER=ollama
CARE_EMBEDDING_MODEL=embeddinggemma
# embeddinggemma supports 128, 256, 512, or 768; set 0 for native dimensions.
# Keep the same model and dimension after indexing unless you rebuild the vector index.
CARE_EMBEDDING_DIMENSIONS=256
CARE_GENERATOR_PROVIDER=ollama
CARE_GENERATION_MODEL=gemma3:4b
CARE_OLLAMA_BASE_URL=http://localhost:11434
CARE_RERANKER_PROVIDER=cross_encoder
CARE_RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L6-v2
CARE_NLI_PROVIDER=cross_encoder
CARE_NLI_MODEL=cross-encoder/nli-deberta-v3-base

# Retrieval/abstention calibration (tune on a held-out benchmark)
CARE_MINIMUM_CARE_SCORE=0.43
CARE_MINIMUM_RELEVANCE_SCORE=0.24
CARE_MINIMUM_CONFIDENCE=0.50

# Source credentials and responsible-use contact
NCBI_API_KEY=
NCBI_EMAIL=researcher@example.org
NICE_API_KEY=
CARE_SOURCE_USER_AGENT=CARE-AnxRAG/0.1 researcher@example.org

# Operations
CARE_ADMIN_KEY=replace-with-a-long-random-value
CARE_ALLOW_NETWORK_SYNC=true
CARE_AUTO_PROMOTE_RESEARCH=false
CARE_REQUEST_TIMEOUT_SECONDS=60

# Safety resources must be localized before deployment.
CARE_CRISIS_RESOURCE_TEXT=If there is immediate danger, contact local emergency services or go to the nearest emergency department, and contact a local crisis service or trusted person.
