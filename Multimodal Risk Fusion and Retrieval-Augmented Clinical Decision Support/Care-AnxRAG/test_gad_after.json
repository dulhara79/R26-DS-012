    {
      "chunk": {
        "chunk_id": "5049ce03c80c708618358d8e5fd63df2c35f174c",
        "document_id": "35ec6bdd603f39cad1034490306b5097824eca6d",
        "version_id": "37f5f53daf79ea773ba50b2e5b8ebbc58af8a12a",
        "source_id": "pubmed_anxiety",
