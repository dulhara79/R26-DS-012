<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ counterpart to allowBackup="false".
     allowBackup covers API <= 30; dataExtractionRules covers 31+, both for
     cloud backup and for device-to-device transfer.

     Excluding everything is the correct posture for this app. SharedPreferences
     holds the local patient roster keyed by subject_id, and
     flutter_secure_storage holds the session. Neither should be copied to a
     clinician's personal Google account, and under PDPA No. 9 of 2022 that
     copy would be a disclosure nobody consented to. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
        <exclude domain="file" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
        <exclude domain="file" />
    </device-transfer>
</data-extraction-rules>