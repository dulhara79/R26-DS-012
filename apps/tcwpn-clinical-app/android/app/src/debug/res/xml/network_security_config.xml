<?xml version="1.0" encoding="utf-8"?>
<!-- DEBUG BUILDS ONLY. Lives in src/debug/, so it is never merged into a
     release APK.

     Cleartext is permitted for exactly three hosts:
       10.0.2.2   the Android emulator's alias for your host machine
       127.0.0.1  } the emulator/device itself, for adb reverse tunnelling
       localhost  }

     Everything else — including a mistyped production URL — still requires
     HTTPS. This is the difference between this file and the blunter android:usesCleartextTraffic="true", which opens every host. -->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
    </domain-config>
</network-security-config>