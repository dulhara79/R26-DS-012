# ClinAnx local environment configuration
# R26-DS-012 clinician mobile app
#
# IMPORTANT:
# - This file is for local development/build use only.
# - Do not commit it to GitHub.
# - Do not place Firebase Admin/service-account private keys here.
# - Flutter does not automatically read .env; pass these values as --dart-define
#   or load them into your shell/build script first.

# -----------------------------------------------------------------------------
# App / research build identity
# -----------------------------------------------------------------------------
APP_VERSION=1.0.0+1
BUILD_ENVIRONMENT=development
BUILD_REVISION=local
DEMO_DATA=false

# -----------------------------------------------------------------------------
# Central Backend / authentication
# Replace with your real endpoints when available.
# Remote clinical endpoints should use HTTPS.
# -----------------------------------------------------------------------------
BACKEND_BASE=
AUTH_BASE=

# Optional TC-WPN health/warm-up endpoint only
TCWPN_BASE=

# -----------------------------------------------------------------------------
# Firebase push slot used by this build
# Allowed values: primary | secondary
# -----------------------------------------------------------------------------
PUSH_FIREBASE_SLOT=primary

# -----------------------------------------------------------------------------
# Firebase PRIMARY project
# Values come from the PRIMARY google-services.json
# -----------------------------------------------------------------------------
FIREBASE_PRIMARY_API_KEY=
FIREBASE_PRIMARY_APP_ID=
FIREBASE_PRIMARY_SENDER_ID=
FIREBASE_PRIMARY_PROJECT_ID=

# Optional iOS value; leave empty for Android-only builds
FIREBASE_PRIMARY_IOS_BUNDLE_ID=

# -----------------------------------------------------------------------------
# Firebase SECONDARY / DR project
# Values come from the SECONDARY google-services.json
# -----------------------------------------------------------------------------
FIREBASE_SECONDARY_API_KEY=
FIREBASE_SECONDARY_APP_ID=
FIREBASE_SECONDARY_SENDER_ID=
FIREBASE_SECONDARY_PROJECT_ID=

# Optional iOS value; leave empty for Android-only builds
FIREBASE_SECONDARY_IOS_BUNDLE_ID=

# -----------------------------------------------------------------------------
# Demo/local authentication only
# Do not use these for real participant/research deployment.
# -----------------------------------------------------------------------------
AUTH_LOCAL=
AUTH_SALT=
